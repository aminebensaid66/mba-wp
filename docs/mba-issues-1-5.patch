+<?php
+/** Lightweight WordPress stubs for deterministic unit tests. */
+define( 'ABSPATH', __DIR__ );
+define( 'MBA_CORE_PATH', dirname( __DIR__, 2 ) . '/wp-content/plugins/mba-site-core/' );
+$GLOBALS['mba_test_post_types'] = array();
+$GLOBALS['mba_test_taxonomies'] = array();
+$GLOBALS['mba_test_meta'] = array();
+$GLOBALS['mba_test_post_meta'] = array();
+$GLOBALS['mba_test_post_types_by_id'] = array( 101 => 'mba_faq', 202 => 'mba_project', 303 => 'post', 404 => 'mba_product' );
+function __( $text ) { return $text; }
+function add_action() {}
+function add_filter() {}
+function sanitize_text_field( $value ) { return trim( strip_tags( (string) $value ) ); }
+function sanitize_textarea_field( $value ) { return trim( strip_tags( (string) $value ) ); }
+function absint( $value ) { return abs( (int) $value ); }
+function wp_kses_post( $value ) { return (string) $value; }
+function esc_url_raw( $value ) { return filter_var( $value, FILTER_SANITIZE_URL ); }
+function rest_sanitize_boolean( $value ) { return filter_var( $value, FILTER_VALIDATE_BOOLEAN ); }
+function current_user_can() { return true; }
+function wp_attachment_is_image( $id ) { return 42 === (int) $id; }
+function get_post_mime_type( $id ) { return 88 === (int) $id ? 'application/pdf' : ( 42 === (int) $id ? 'image/webp' : false ); }
+function wp_unslash( $value ) { return $value; }
+function get_post_type( $id = null ) { return $GLOBALS['mba_test_post_types_by_id'][ (int) $id ] ?? null; }
+function get_post_meta( $id, $key, $single = false ) { return $GLOBALS['mba_test_post_meta'][ (int) $id ][ $key ] ?? ( $single ? '' : array() ); }
+function update_post_meta( $id, $key, $value ) { $GLOBALS['mba_test_post_meta'][ (int) $id ][ $key ] = $value; return true; }
+function register_post_type( $type, $args ) { $GLOBALS['mba_test_post_types'][ $type ] = $args; }
+function register_taxonomy( $taxonomy, $objects, $args ) { $GLOBALS['mba_test_taxonomies'][ $taxonomy ] = array( 'objects' => (array) $objects, 'args' => $args ); }
+function register_post_meta( $post_type, $key, $args ) { $GLOBALS['mba_test_meta'][ $post_type ][ $key ] = $args; }
diff --git a/tests/php/run.php b/tests/php/run.php
new file mode 100644
index 0000000000000000000000000000000000000000..0c798e27d7da6e9ed1f9b6ef4c5a4ce3d8955270
--- /dev/null
+++ b/tests/php/run.php
@@ -0,0 +1,60 @@
+<?php
+require __DIR__ . '/bootstrap.php';
+require MBA_CORE_PATH . 'includes/content-types.php';
+require MBA_CORE_PATH . 'includes/meta-fields.php';
+require MBA_CORE_PATH . 'includes/product-admin.php';
+
+function mba_assert( $condition, string $message ): void {
+	if ( ! $condition ) {
+		fwrite( STDERR, "FAIL: {$message}\n" );
+		exit( 1 );
+	}
+}
+
+mba_core_register_content_types();
+mba_core_register_meta_fields();
+
+foreach ( array( 'mba_product', 'mba_project', 'mba_faq', 'mba_testimonial', 'mba_partner' ) as $type ) {
+	mba_assert( isset( $GLOBALS['mba_test_post_types'][ $type ] ), "registered post type {$type}" );
+	mba_assert( true === $GLOBALS['mba_test_post_types'][ $type ]['show_in_rest'], "REST enabled for {$type}" );
+}
+mba_assert( 'produits' === $GLOBALS['mba_test_post_types']['mba_product']['has_archive'], 'product archive is /produits/' );
+mba_assert( false === $GLOBALS['mba_test_post_types']['mba_faq']['publicly_queryable'], 'FAQ items are not individually public' );
+mba_assert( isset( $GLOBALS['mba_test_taxonomies']['mba_product_category'] ), 'product category registered' );
+mba_assert( isset( $GLOBALS['mba_test_taxonomies']['mba_application_type'] ), 'application type registered' );
+
+$required_product_meta = array(
+	'mba_short_description', 'mba_benefits', 'mba_configurations', 'mba_materials_profiles',
+	'mba_glazing_options', 'mba_colors_finishes', 'mba_performance_details', 'mba_applications',
+	'mba_maintenance', 'mba_gallery', 'mba_technical_document', 'mba_featured', 'mba_display_order',
+	'mba_related_faqs', 'mba_related_projects',
+);
+foreach ( $required_product_meta as $key ) {
+	mba_assert( isset( $GLOBALS['mba_test_meta']['mba_product'][ $key ] ), "product meta {$key} registered" );
+}
+
+mba_assert( array( 'One', 'Two' ) === mba_core_sanitize_string_list( array( ' One ', '', '<b>Two</b>', 'One' ) ), 'string repeater sanitization' );
+mba_assert( array( 3, 9 ) === mba_core_sanitize_id_list( array( '3', -9, 0, 3 ) ), 'ID list sanitization and dedupe' );
+mba_assert( array( 42 ) === mba_core_sanitize_image_id_list( array( 42, 88, 999 ) ), 'gallery keeps image attachment IDs only' );
+mba_assert( 88 === mba_core_sanitize_pdf_attachment_id( 88 ) && 0 === mba_core_sanitize_pdf_attachment_id( 42 ), 'technical document accepts PDF attachments only' );
+mba_assert( 9999 === mba_core_sanitize_display_order( 12000 ), 'display order is clamped to editor range' );
+mba_assert( 5 === mba_core_sanitize_rating( 9 ), 'testimonial rating is clamped to five' );
+mba_assert( array( 101 ) === mba_core_sanitize_faq_id_list( array( 101, 202, 303 ) ), 'REST FAQ relationships reject wrong post types' );
+mba_assert( array( 202 ) === mba_core_sanitize_project_id_list( array( 101, 202, 303 ) ), 'REST project relationships reject wrong post types' );
+mba_assert( array( 404 ) === mba_core_sanitize_product_id_list( array( 404, 202, 303 ) ), 'REST product backlinks reject wrong post types' );
+$finishes = mba_core_sanitize_colors_finishes( array( array( 'label' => ' Bronze ', 'image_id' => 42 ), array( 'label' => 'Bad', 'image_id' => 99 ) ) );
+mba_assert( 42 === $finishes[0]['image_id'] && 0 === $finishes[1]['image_id'], 'finish images reject non-image attachment IDs' );
+$performance = mba_core_sanitize_performance_details( array( array( 'label' => '<b>Uw</b>', 'value' => ' verified ' ) ) );
+mba_assert( 'Uw' === $performance[0]['label'] && 'verified' === $performance[0]['value'], 'performance rows sanitized' );
+
+
+$rows = mba_core_zip_rows( array( 'label' => array( 'A', 'B' ), 'value' => array( '1' ) ), array( 'label', 'value' ) );
+mba_assert( 2 === count( $rows ) && '' === $rows[1]['value'], 'parallel repeater rows are zipped safely' );
+mba_assert( array( 101 ) === mba_core_validate_relationship_ids( array( 101, 202, 303 ), 'mba_faq' ), 'relationship IDs are constrained to expected post type' );
+$GLOBALS['mba_test_post_meta'][202]['mba_related_products'] = array( 7 );
+mba_core_sync_product_backlinks( 55, 'mba_project', array(), array( 202 ) );
+mba_assert( array( 7, 55 ) === $GLOBALS['mba_test_post_meta'][202]['mba_related_products'], 'project backlink added' );
+mba_core_sync_product_backlinks( 55, 'mba_project', array( 202 ), array() );
+mba_assert( array( 7 ) === $GLOBALS['mba_test_post_meta'][202]['mba_related_products'], 'project backlink removed' );
+
+fwrite( STDOUT, "PHP behavior tests passed.\n" );
