 /**
- * Register safe scalar metadata. Rich repeaters and media relationships are a
- * dedicated backlog item so their editing experience can be tested properly.
+ * Metadata authorization uses the actual target post capability.
+ *
+ * @param bool   $allowed Existing authorization result.
+ * @param string $meta_key Meta key.
+ * @param int    $post_id  Post ID.
+ * @return bool
+ */
+function mba_core_meta_auth( bool $allowed, string $meta_key, int $post_id ): bool {
+	unset( $allowed, $meta_key );
+	return current_user_can( 'edit_post', $post_id );
+}
+
+/**
+ * Sanitize an array of plain strings.
+ *
+ * @param mixed $value Raw value.
+ * @return array<string>
+ */
+function mba_core_sanitize_string_list( $value ): array {
+	$output = array();
+	foreach ( (array) $value as $item ) {
+		$item = sanitize_text_field( (string) $item );
+		if ( '' !== $item ) {
+			$output[] = $item;
+		}
+	}
+	return array_values( array_unique( $output ) );
+}
+
+/**
+ * Sanitize a list of positive post/attachment IDs.
+ *
+ * @param mixed $value Raw value.
+ * @return array<int>
+ */
+function mba_core_sanitize_id_list( $value ): array {
+	$ids = array_map( 'absint', (array) $value );
+	$ids = array_filter( $ids );
+	return array_values( array_unique( $ids ) );
+}
+
+
+/**
+ * Keep only image attachment IDs.
+ *
+ * @param mixed $value Raw value.
+ * @return array<int>
+ */
+function mba_core_sanitize_image_id_list( $value ): array {
+	$output = array();
+	foreach ( mba_core_sanitize_id_list( $value ) as $attachment_id ) {
+		if ( wp_attachment_is_image( $attachment_id ) ) {
+			$output[] = $attachment_id;
+		}
+	}
+	return $output;
+}
+
+/**
+ * Sanitize one PDF attachment reference.
+ *
+ * Invalid IDs are reduced to zero so unsupported document types are never
+ * persisted through REST or programmatic metadata writes.
+ *
+ * @param mixed $value Raw attachment ID.
+ * @return int
+ */
+function mba_core_sanitize_pdf_attachment_id( $value ): int {
+	$attachment_id = absint( $value );
+	if ( ! $attachment_id || 'application/pdf' !== get_post_mime_type( $attachment_id ) ) {
+		return 0;
+	}
+	return $attachment_id;
+}
+
+/**
+ * Clamp editorial display order to the supported UI range.
+ *
+ * @param mixed $value Raw value.
+ * @return int
+ */
+function mba_core_sanitize_display_order( $value ): int {
+	return min( 9999, absint( $value ) );
+}
+
+/**
+ * Clamp optional testimonial ratings to 0 (unset) or 1–5.
+ *
+ * @param mixed $value Raw value.
+ * @return int
+ */
+function mba_core_sanitize_rating( $value ): int {
+	return min( 5, absint( $value ) );
+}
+
+/**
+ * Keep relationship IDs constrained to one target post type.
+ *
+ * @param mixed  $value Raw IDs.
+ * @param string $post_type Expected post type.
+ * @return array<int>
+ */
+function mba_core_sanitize_relationship_id_list( $value, string $post_type ): array {
+	$output = array();
+	foreach ( mba_core_sanitize_id_list( $value ) as $post_id ) {
+		if ( $post_type === get_post_type( $post_id ) ) {
+			$output[] = $post_id;
+		}
+	}
+	return $output;
+}
+
+/**
+ * Sanitize related FAQ IDs.
+ *
+ * @param mixed $value Raw FAQ IDs.
+ * @return array<int>
+ */
+function mba_core_sanitize_faq_id_list( $value ): array {
+	return mba_core_sanitize_relationship_id_list( $value, 'mba_faq' );
+}
+
+/**
+ * Sanitize related project IDs.
+ *
+ * @param mixed $value Raw project IDs.
+ * @return array<int>
+ */
+function mba_core_sanitize_project_id_list( $value ): array {
+	return mba_core_sanitize_relationship_id_list( $value, 'mba_project' );
+}
+
+/**
+ * Sanitize related product IDs.
+ *
+ * @param mixed $value Raw product IDs.
+ * @return array<int>
+ */
+function mba_core_sanitize_product_id_list( $value ): array {
+	return mba_core_sanitize_relationship_id_list( $value, 'mba_product' );
+}
+
+/**
+ * Sanitize label/value performance rows.
+ *
+ * @param mixed $value Raw value.
+ * @return array<array{label:string,value:string}>
+ */
+function mba_core_sanitize_performance_details( $value ): array {
+	$output = array();
+	foreach ( (array) $value as $row ) {
+		if ( ! is_array( $row ) ) {
+			continue;
+		}
+		$label = sanitize_text_field( (string) ( $row['label'] ?? '' ) );
+		$detail = sanitize_text_field( (string) ( $row['value'] ?? '' ) );
+		if ( '' !== $label || '' !== $detail ) {
+			$output[] = array( 'label' => $label, 'value' => $detail );
+		}
+	}
+	return $output;
+}
+
+/**
+ * Sanitize color/finish rows and keep only image attachment IDs.
+ *
+ * @param mixed $value Raw value.
+ * @return array<array{label:string,image_id:int}>
+ */
+function mba_core_sanitize_colors_finishes( $value ): array {
+	$output = array();
+	foreach ( (array) $value as $row ) {
+		if ( ! is_array( $row ) ) {
+			continue;
+		}
+		$label    = sanitize_text_field( (string) ( $row['label'] ?? '' ) );
+		$image_id = absint( $row['image_id'] ?? 0 );
+		if ( $image_id && ! wp_attachment_is_image( $image_id ) ) {
+			$image_id = 0;
+		}
+		if ( '' !== $label || $image_id ) {
+			$output[] = array( 'label' => $label, 'image_id' => $image_id );
+		}
+	}
+	return $output;
+}
