+/**
+ * Register one hierarchical taxonomy with consistent REST/admin behavior.
+ *
+ * @param string        $taxonomy Taxonomy key.
+ * @param array<string> $objects  Object types.
+ * @param string        $plural   Plural label.
+ * @param string        $singular Singular label.
+ * @param bool          $public   Public queryability.
+ * @param string        $rewrite  Rewrite slug when public.
+ */
+function mba_core_register_taxonomy( string $taxonomy, array $objects, string $plural, string $singular, bool $public, string $rewrite ): void {
+	$args = array(
+		'labels'             => array(
+			'name'          => $plural,
+			'singular_name' => $singular,
+			'search_items'  => sprintf(
+				/* translators: %s: plural taxonomy label. */
+				__( 'Search %s', 'mba-site-core' ),
+				$plural
+			),
+			'all_items'     => sprintf(
+				/* translators: %s: plural taxonomy label. */
+				__( 'All %s', 'mba-site-core' ),
+				$plural
+			),
+			'edit_item'     => sprintf(
+				/* translators: %s: singular taxonomy label. */
+				__( 'Edit %s', 'mba-site-core' ),
+				$singular
+			),
+			'update_item'   => sprintf(
+				/* translators: %s: singular taxonomy label. */
+				__( 'Update %s', 'mba-site-core' ),
+				$singular
+			),
+			'add_new_item'  => sprintf(
+				/* translators: %s: singular taxonomy label. */
+				__( 'Add New %s', 'mba-site-core' ),
+				$singular
+			),
+		),
+		'public'             => $public,
+		'publicly_queryable' => $public,
+		'show_ui'            => true,
+		'show_in_rest'       => true,
+		'hierarchical'       => true,
+		'show_admin_column'  => true,
+	);
+	if ( $public ) {
+		$args['rewrite'] = array(
+			'slug'       => $rewrite,
+			'with_front' => false,
+		);
+	} else {
+		$args['rewrite'] = false;
+	}
+	register_taxonomy( $taxonomy, $objects, $args );
+}
