@@ -0,0 +1,58 @@
+<?php
+/**
+ * Temporary/sample content launch safety checks.
+ *
+ * @package MBA_Site_Core
+ */
+
+if ( ! defined( 'ABSPATH' ) ) {
+	exit;
+}
+
+/**
+ * Detect temporary sample catalogue/media markers before launch.
+ *
+ * @return bool
+ */
+function mba_core_has_temporary_content(): bool {
+	$query = new WP_Query(
+		array(
+			'post_type'      => array( 'mba_product', 'mba_project', 'attachment' ),
+			'post_status'    => array( 'publish', 'draft', 'pending', 'private', 'inherit' ),
+			'posts_per_page' => 1,
+			'fields'         => 'ids',
+			'meta_query'     => array(
+				'relation' => 'OR',
+				array( 'key' => 'mba_sample_content', 'value' => '1' ),
+				array( 'key' => 'mba_temporary_media_source', 'compare' => 'EXISTS' ),
+			),
+		)
+	);
+	return $query->have_posts();
+}
+
+/**
+ * Add a direct Site Health test that blocks a clean launch status while temporary media remains.
+ *
+ * @param array<string,mixed> $tests Existing tests.
+ * @return array<string,mixed>
+ */
+function mba_core_site_health_tests( array $tests ): array {
+	$tests['direct']['mba_temporary_content'] = array(
+		'label' => __( 'MBA temporary catalogue/media', 'mba-site-core' ),
+		'test'  => static function (): array {
+			$temporary = mba_core_has_temporary_content();
+			return array(
+				'label'       => $temporary ? __( 'Temporary MBA sample content or media is still configured', 'mba-site-core' ) : __( 'No temporary MBA sample media is configured', 'mba-site-core' ),
+				'status'      => $temporary ? 'critical' : 'good',
+				'badge'       => array( 'label' => __( 'MBA content', 'mba-site-core' ), 'color' => 'blue' ),
+				'description' => $temporary
+					? '<p>' . esc_html__( 'Replace all temporary catalogue/media items with approved MBA content before production launch. See docs/sample-media-sources.md.', 'mba-site-core' ) . '</p>'
+					: '<p>' . esc_html__( 'The launch check found no content marked as temporary.', 'mba-site-core' ) . '</p>',
+				'test'        => 'mba_temporary_content',
+			);
+		},
+	);
+	return $tests;
+}
+add_filter( 'site_status_tests', 'mba_core_site_health_tests' );
