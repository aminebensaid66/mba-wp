+name: CI
+
+on:
+  push:
+    branches: [main]
+  pull_request:
+
+permissions:
+  contents: read
+
+jobs:
+  quality:
+    runs-on: ubuntu-latest
+    steps:
+      - uses: actions/checkout@v4
+      - uses: shivammathur/setup-php@v2
+        with:
+          php-version: '8.3'
+          tools: composer:v2
+      - uses: actions/setup-node@v4
+        with:
+          node-version: '22'
+      - name: Cache Composer and npm downloads
+        uses: actions/cache@v4
+        with:
+          path: |
+            ~/.cache/composer/files
+            ~/.npm
+          key: ${{ runner.os }}-quality-${{ hashFiles('composer.json', 'package.json') }}
+          restore-keys: |
+            ${{ runner.os }}-quality-
+      - name: Validate Composer metadata
+        run: composer validate --no-check-lock
+      - name: Install PHP quality tools
+        run: composer install --no-interaction --no-progress --prefer-dist
+      - name: PHP syntax, standards, static analysis, and tests
+        run: composer check
+      - name: Install JS/CSS quality tools
+        run: npm install --no-audit --no-fund
+      - name: JavaScript/CSS lint and JSON/YAML validation
+        run: npm run check
+      - name: Validate Docker Compose
+        run: docker compose config --quiet
+      - name: Prove PHP syntax gate rejects invalid PHP
+        run: |
+          printf '<?php syntax error' >/tmp/mba-invalid.php
+          if php -l /tmp/mba-invalid.php >/dev/null 2>&1; then
+            echo 'Expected invalid PHP syntax to fail.' >&2
+            exit 1
+          fi
+
+  wordpress-smoke:
+    runs-on: ubuntu-latest
+    needs: quality
+    env:
+      COMPOSE_PROJECT_NAME: mba_wp_ci
+      WORDPRESS_PORT: 8080
+      DB_NAME: mba_wordpress
+      DB_USER: mba_wordpress
+      DB_PASSWORD: ci-local-password
+      DB_ROOT_PASSWORD: ci-local-root-password
+      WP_DEBUG: 'true'
+      WP_SITE_URL: http://localhost:8080
+      WP_SITE_TITLE: MBA CI
+      WP_ADMIN_USER: mba_admin
+      WP_ADMIN_PASSWORD: ci-local-admin-password
+      WP_ADMIN_EMAIL: ci@example.test
+    steps:
+      - uses: actions/checkout@v4
+      - name: Write CI environment
+        run: env | grep -E '^(COMPOSE_PROJECT_NAME|WORDPRESS_PORT|DB_|WP_)' > .env
+      - name: Clean install, activation, media, restart, persistence
+        run: ./bin/smoke-wordpress.sh
+      - name: WordPress logs
+        if: failure()
+        run: docker compose logs --no-color wordpress database || true
+      - name: Tear down
+        if: always()
+        run: docker compose down --volumes --remove-orphans || true
