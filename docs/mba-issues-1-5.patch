@@ -0,0 +1,67 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
+cd "$ROOT_DIR"
+
+if ! command -v docker >/dev/null 2>&1; then
+  echo "Docker is required. Install Docker Desktop/Engine with Compose v2." >&2
+  exit 1
+fi
+
+if [[ ! -f .env ]]; then
+  cp .env.example .env
+  echo "Created .env from .env.example. Local placeholder credentials are for development only."
+fi
+
+env_value() {
+  local key="$1"
+  local line
+  line="$(grep -E "^${key}=" .env | tail -n 1 || true)"
+  printf '%s' "${line#*=}"
+}
+
+WP_SITE_URL="${WP_SITE_URL:-$(env_value WP_SITE_URL)}"
+WP_SITE_TITLE="${WP_SITE_TITLE:-$(env_value WP_SITE_TITLE)}"
+WP_ADMIN_USER="${WP_ADMIN_USER:-$(env_value WP_ADMIN_USER)}"
+WP_ADMIN_PASSWORD="${WP_ADMIN_PASSWORD:-$(env_value WP_ADMIN_PASSWORD)}"
+WP_ADMIN_EMAIL="${WP_ADMIN_EMAIL:-$(env_value WP_ADMIN_EMAIL)}"
+
+: "${WP_SITE_URL:?WP_SITE_URL is required in .env}"
+: "${WP_SITE_TITLE:?WP_SITE_TITLE is required in .env}"
+: "${WP_ADMIN_USER:?WP_ADMIN_USER is required in .env}"
+: "${WP_ADMIN_PASSWORD:?WP_ADMIN_PASSWORD is required in .env}"
+: "${WP_ADMIN_EMAIL:?WP_ADMIN_EMAIL is required in .env}"
+
+docker compose up -d database wordpress
+
+wp_cli() {
+  docker compose --profile tools run --rm cli wp "$@" --allow-root
+}
+
+for attempt in {1..30}; do
+  if wp_cli core version >/dev/null 2>&1; then
+    break
+  fi
+  if [[ "$attempt" -eq 30 ]]; then
+    echo "WordPress files were not ready after repeated checks." >&2
+    exit 1
+  fi
+  sleep 2
+done
+
+if ! wp_cli core is-installed >/dev/null 2>&1; then
+  wp_cli core install \
+    --url="$WP_SITE_URL" \
+    --title="$WP_SITE_TITLE" \
+    --admin_user="$WP_ADMIN_USER" \
+    --admin_password="$WP_ADMIN_PASSWORD" \
+    --admin_email="$WP_ADMIN_EMAIL" \
+    --skip-email
+fi
+
+wp_cli plugin activate mba-site-core
+wp_cli theme activate mba-menuiseries
+wp_cli rewrite flush --hard
+
+echo "MBA WordPress is ready at $WP_SITE_URL"
