@@ -0,0 +1,31 @@
+#!/usr/bin/env bash
+set -euo pipefail
+ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
+cd "$ROOT_DIR"
+
+./bin/setup.sh
+wp_cli() { docker compose --profile tools run --rm cli wp "$@" --allow-root; }
+
+wp_cli plugin is-active mba-site-core
+wp_cli theme is-active mba-menuiseries
+
+product_id="$(wp_cli post create --post_type=mba_product --post_title='Persistence Test Product' --post_status=publish --porcelain)"
+wp_cli post meta update "$product_id" mba_short_description 'Temporary CI product used for persistence verification.' >/dev/null
+
+# Generate a tiny PNG inside the transient CLI container; no binary fixture is committed.
+attachment_id="$(docker compose --profile tools run --rm cli sh -lc 'printf iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAQAAAC1HAwCAAAAC0lEQVR42mNk+A8AAQUBAScY42YAAAAASUVORK5CYII= | base64 -d >/tmp/mba-ci.png; wp media import /tmp/mba-ci.png --post_id='"$product_id"' --featured_image --porcelain --allow-root')"
+
+docker compose restart database wordpress >/dev/null
+sleep 5
+
+wp_cli post get "$product_id" --field=post_title | grep -F 'Persistence Test Product' >/dev/null
+wp_cli post meta get "$product_id" _thumbnail_id | grep -F "$attachment_id" >/dev/null
+
+inactive_theme="$(wp_cli theme list --status=inactive --field=name | head -n 1 || true)"
+if [[ -n "$inactive_theme" ]]; then
+  wp_cli theme activate "$inactive_theme" >/dev/null
+  wp_cli eval 'if (! post_type_exists("mba_product")) { fwrite(STDERR, "mba_product missing\n"); exit(1); }' >/dev/null
+  wp_cli theme activate mba-menuiseries >/dev/null
+fi
+
+echo "WordPress smoke/persistence checks passed. Product $product_id, attachment $attachment_id."
