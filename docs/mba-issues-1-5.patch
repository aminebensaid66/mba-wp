+#!/usr/bin/env bash
+set -euo pipefail
+ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
+cd "$ROOT_DIR"
+mapfile -t files < <(find wp-content bin tests -type f -name '*.php' -print | sort)
+for file in "${files[@]}"; do
+  php -l "$file" >/dev/null
+done
+printf 'PHP syntax OK (%d files)\n' "${#files[@]}"
