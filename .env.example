# Copy to .env for local development. These are local-only placeholders, not production secrets.
COMPOSE_PROJECT_NAME=mba_wp
WORDPRESS_PORT=8080
WORDPRESS_IMAGE=wordpress:6.8.2-php8.3-apache
WPCLI_IMAGE=wordpress:cli-2.12.0-php8.3
MARIADB_IMAGE=mariadb:11.4.5
DB_NAME=mba_wordpress
DB_USER=mba_wordpress
DB_PASSWORD=change-this-local-password
DB_ROOT_PASSWORD=change-this-local-root-password
WP_DEBUG=true
WP_SITE_URL=http://localhost:8080
WP_SITE_TITLE='MBA Menuiseries Local'
WP_ADMIN_USER=mba_admin
WP_ADMIN_PASSWORD=change-this-local-admin-password
WP_ADMIN_EMAIL=dev@example.test
