parameters:
    level: 5
    parallel:
        maximumNumberOfProcesses: 1
    paths:
        - wp-content/plugins/mba-site-core
        - wp-content/themes/mba-menuiseries
    scanFiles:
        - vendor/php-stubs/wordpress-stubs/wordpress-stubs.php
    excludePaths:
        analyse:
            - vendor
            - node_modules (?)
    treatPhpDocTypesAsCertain: false
