{
  "name": "mba-menuiseries/mba-wp",
  "description": "Development quality tooling for the MBA Menuiseries WordPress site.",
  "type": "project",
  "require-dev": {
    "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
    "php-stubs/wordpress-stubs": "^6.8",
    "phpstan/phpstan": "^2.1",
    "squizlabs/php_codesniffer": "^3.13",
    "wp-coding-standards/wpcs": "^3.4.1"
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    },
    "sort-packages": true
  },
  "scripts": {
    "lint:php": "@php ./bin/lint-php.php",
    "phpcs": "phpcs -n",
    "phpstan": "phpstan analyse --no-progress",
    "test:lint-failure": "sh ./tests/ci/assert-invalid-php-fails.sh",
    "check": [
      "@lint:php",
      "@phpcs",
      "@phpstan",
      "@test:theme",
      "@test:lint-failure"
    ],
    "test:theme": "@php tests/theme/theme-foundation.php"
  }
}
