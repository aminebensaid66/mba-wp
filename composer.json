{
  "name": "mba-menuiseries/mba-wp",
  "description": "Development quality tooling for the MBA Menuiseries WordPress site.",
  "type": "project",
  "require-dev": {
    "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
    "php-stubs/wordpress-stubs": "^6.8",
    "phpstan/phpstan": "^2.1",
    "squizlabs/php_codesniffer": "^3.13",
    "wp-coding-standards/wpcs": "^3.4.1"
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    },
    "sort-packages": true
  },
  "scripts": {
    "lint:php": "@php ./bin/lint-php.php",
    "phpcs": "phpcs -n",
    "phpstan": "phpstan analyse --no-progress --memory-limit=2G",
    "test:lint-failure": "sh ./tests/ci/assert-invalid-php-fails.sh",
    "check": [
      "@lint:php",
      "@phpcs",
      "@phpstan",
      "@test:theme",
      "@test:content-types",
      "@test:products",
      "@test:quotes",
      "@test:contact",
      "@test:seo",
      "@test:analytics",
      "@test:lint-failure"
    ],
    "test:theme": "@php tests/theme/theme-foundation.php",
    "test:content-types": "@php tests/php/content-types-test.php",
    "test:products": "@php tests/php/product-fields-test.php",
    "test:quotes": "@php tests/php/quote-leads-test.php",
    "test:contact": "@php tests/php/contact-leads-test.php",
    "test:seo": "@php tests/php/seo-test.php",
    "test:analytics": "@php tests/php/analytics-test.php"
  }
}
